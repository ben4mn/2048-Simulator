# 2048 Simulator — server environment
# Copy to .env and fill in. Docker Compose reads this via `env_file: .env`.
# For local dev (npm run server:dev) the secrets are optional: missing ones are
# replaced with random EPHEMERAL values and a loud warning is printed.

# Port the Node server listens on inside the container (compose maps 3048 -> 3000).
PORT=3000

# Directory for the SQLite database (app.db). In Docker this is the /data
# volume; in local dev it defaults to ./data if unset.
DATA_DIR=/data

# Secret used to sign the `session` JWT cookie.
# REQUIRED in production, minimum 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=

# Secret from which the AES-256-GCM key-vault encryption key is derived
# (encrypts users' stored provider API keys at rest).
# REQUIRED in production, minimum 32 characters. Generate: openssl rand -hex 32
# NOTE: changing this makes previously stored user keys undecryptable.
KEY_ENCRYPTION_SECRET=

# Admin account, (re)seeded on every boot: created if missing, password
# re-hashed if changed, is_admin forced on.
ADMIN_USERNAME=ben
ADMIN_PASSWORD=

# Server-side provider keys — used ONLY for the admin user's AI requests.
# Non-admin users store their own keys (encrypted) via the UI.
ANTHROPIC_API_KEY=
# Optional:
OPENAI_API_KEY=
